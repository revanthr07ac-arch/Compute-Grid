# ComputeGrid Root Environment Variables
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Database (SQLite for zero-dependency local dev; PostgreSQL for production)
DATABASE_URL=file:./prisma/dev.db

# Redis & BullMQ Queue (Auto-falls back to resilient in-process queue if Redis is not running)
REDIS_URL=redis://localhost:6379

# Authentication & JWT
JWT_SECRET=computegrid_dev_jwt_secret_key_super_secure_9921
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_DAYS=7

# Object Storage (local or s3)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/storage

# S3 Configuration (MinIO / AWS)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=computegrid-artifacts
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Grid Worker Policies
WORKER_HEARTBEAT_TIMEOUT_SEC=30
TASK_LEASE_TIMEOUT_SEC=60
MAX_TASK_RETRIES=3
