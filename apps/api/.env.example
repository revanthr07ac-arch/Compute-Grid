# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Database (SQLite for local zero-dependency testing, PostgreSQL for production)
DATABASE_URL=file:./dev.db
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/computegrid?schema=public

# Redis & Queue (Leave as redis://localhost:6379, will auto-fallback to resilient in-process queue if unavailable)
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_computegrid_production_2026_xyz
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_DAYS=7

# Storage Configuration (local or s3)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/storage

# AWS / MinIO S3 Settings (when STORAGE_DRIVER=s3)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=computegrid-artifacts
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Grid Worker Policies
WORKER_HEARTBEAT_TIMEOUT_SEC=30
TASK_LEASE_TIMEOUT_SEC=60
MAX_TASK_RETRIES=3
