# ==============================================================================
# ComputeGrid Production Environment Configuration Template
# ==============================================================================
# IMPORTANT: Copy this file to '.env' in production and replace all placeholder
# values with cryptographically secure random values.
#
# Generate secure keys via:
#   openssl rand -hex 32
# ==============================================================================

# Application Environment & Domain
NODE_ENV=production
DOMAIN_NAME=computegrid.example.com
CORS_ORIGIN=https://computegrid.example.com
PORT=4000
AUTO_SEED=true

# Security Secrets (MUST be generated uniquely for every production deployment)
# Generate using: openssl rand -hex 32
JWT_SECRET=replace_with_64_char_cryptographically_secure_random_hex_string
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_DAYS=7

# Worker Enrollment & Authn Token
# Generate using: openssl rand -hex 24
WORKER_ENROLLMENT_TOKEN=cg_enroll_replace_with_random_token_key_here

# PostgreSQL Database Configuration
POSTGRES_USER=computegrid_user
POSTGRES_PASSWORD=replace_with_strong_database_password_here
POSTGRES_DB=computegrid_prod
DATABASE_URL=postgresql://computegrid_user:replace_with_strong_database_password_here@postgres:5432/computegrid_prod?schema=public

# Redis Task Queue & Caching Configuration
REDIS_URL=redis://redis:6379

# Object Storage / Artifacts Configuration
# Options: 'local' | 's3'
STORAGE_DRIVER=s3
STORAGE_LOCAL_DIR=/app/data/storage

# MinIO / S3 Configuration
# If using self-hosted MinIO:
MINIO_ROOT_USER=computegrid_minio_admin
MINIO_ROOT_PASSWORD=replace_with_strong_minio_password_here
S3_ENDPOINT=http://minio:9000
S3_BUCKET=computegrid-artifacts
S3_REGION=us-east-1
S3_ACCESS_KEY=computegrid_minio_admin
S3_SECRET_KEY=replace_with_strong_minio_password_here

# If using AWS S3 or Cloudflare R2 (Managed Cloud Object Storage):
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=your-production-computegrid-bucket
# S3_REGION=us-east-1
# S3_ACCESS_KEY=AKIAXXXXXXXXXXXXXXXX
# S3_SECRET_KEY=YYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYY

# Distributed Compute Cluster Tuning
WORKER_HEARTBEAT_TIMEOUT_SEC=30
TASK_LEASE_TIMEOUT_SEC=60
MAX_TASK_RETRIES=3

# Containerized Worker Node Concurrency
WORKER_ALPHA_CONCURRENCY=4
WORKER_BETA_CONCURRENCY=4

# Let's Encrypt Email (for automated TLS certificate renewal)
LETSENCRYPT_EMAIL=admin@computegrid.example.com
